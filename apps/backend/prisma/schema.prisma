generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  CANDIDATE
  RECRUITER
  ADMIN
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
}

enum VerificationStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

enum JobStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum EmploymentType {
  FULL_TIME
  PART_TIME
  CONTRACT
  INTERNSHIP
  TEMPORARY
}

enum WorkMode {
  ONSITE
  HYBRID
  REMOTE
}

enum ApplicationStatus {
  APPLIED
  VIEWED
  INTERVIEW
  ACCEPTED
  REJECTED
}

model User {
  id                 String              @id @default(uuid()) @db.Uuid
  email              String              @unique @db.VarChar(320)
  passwordHash       String              @map("password_hash") @db.VarChar(255)
  fullName           String              @map("full_name") @db.VarChar(160)
  role               Role
  accountStatus      AccountStatus       @default(ACTIVE) @map("account_status")
  verificationStatus VerificationStatus? @map("verification_status")
  createdAt          DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)

  candidateProfile CandidateProfile?
  company          Company?
  settings         UserSettings?
  jobs             Job[]                @relation("JobRecruiter")
  applications     Application[]        @relation("CandidateApplications")
  notifications    Notification[]
  auditEntries     AuditLog[]            @relation("AuditActor")
  auditTargets     AuditLog[]            @relation("AuditTarget")
  refreshTokens    RefreshToken[]

  @@map("users")
}

model UserSettings {
  id                        String   @id @default(uuid()) @db.Uuid
  userId                    String   @unique @map("user_id") @db.Uuid
  notifyJobPending          Boolean  @default(true) @map("notify_job_pending")
  notifyRecruiterRegistered Boolean  @default(true) @map("notify_recruiter_registered")
  notifyBrowserSound        Boolean  @default(false) @map("notify_browser_sound")
  notifyNewApplication      Boolean  @default(true) @map("notify_new_application")
  notifyJobModeration       Boolean  @default(true) @map("notify_job_moderation")
  notifyInterviewReminder   Boolean  @default(true) @map("notify_interview_reminder")
  notifyWeeklyReport        Boolean  @default(false) @map("notify_weekly_report")
  updatedAt                 DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdAt                 DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_settings")
}

model CandidateProfile {
  id                String   @id @default(uuid()) @db.Uuid
  userId            String   @unique @map("user_id") @db.Uuid
  phone             String?  @db.VarChar(32)
  location          String?  @db.VarChar(160)
  headline          String?  @db.VarChar(200)
  bio               String?  @db.Text
  experienceYears   Decimal? @map("experience_years") @db.Decimal(4, 1)
  level             String?  @db.VarChar(80)
  expectedSalaryMin Decimal? @map("expected_salary_min") @db.Decimal(12, 2)
  expectedSalaryMax Decimal? @map("expected_salary_max") @db.Decimal(12, 2)
  workPreference    String?  @map("work_preference") @db.VarChar(240)
  skills            Json?
  skillLevels       Json?    @map("skill_levels")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("candidate_profiles")
}

model Company {
  id                  String   @id @default(uuid()) @db.Uuid
  recruiterId         String   @unique @map("recruiter_id") @db.Uuid
  name                String   @db.VarChar(200)
  brandName           String?  @map("brand_name") @db.VarChar(200)
  legalName           String?  @map("legal_name") @db.VarChar(300)
  description         String?  @db.Text
  website             String?  @db.VarChar(500)
  industry            String?  @db.VarChar(120)
  specialties         Json?
  location            String?  @db.VarChar(160)
  address             String?  @db.VarChar(240)
  offices             Json?
  taxCode             String?  @map("tax_code") @db.VarChar(32)
  contactPhone        String?  @map("contact_phone") @db.VarChar(32)
  contactEmail        String?  @map("contact_email") @db.VarChar(320)
  companySize         String?  @map("company_size") @db.VarChar(80)
  foundedYear         Int?     @map("founded_year")
  followersCount      Int      @default(0) @map("followers_count")
  rating              Decimal? @db.Decimal(3, 1)
  reviewCount         Int      @default(0) @map("review_count")
  benefits            Json?
  benefitsDetail      Json?    @map("benefits_detail")
  responseRate        Decimal? @map("response_rate") @db.Decimal(5, 2)
  avgResponseDays     Decimal? @map("avg_response_days") @db.Decimal(4, 1)
  coverUrl            String?  @map("cover_url") @db.VarChar(500)
  logoUrl             String?  @map("logo_url") @db.VarChar(500)
  galleryUrls         Json?    @map("gallery_urls")
  metrics             Json?
  cultureValues       Json?    @map("culture_values")
  team                Json?
  featured            Boolean  @default(false)
  verificationDetails String?  @map("verification_details") @db.Text
  licenseDocumentUrl  String?  @map("license_document_url") @db.VarChar(500)
  licenseDocumentName String?  @map("license_document_name") @db.VarChar(200)
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  recruiter User  @relation(fields: [recruiterId], references: [id], onDelete: Cascade)
  jobs      Job[]

  @@map("companies")
}

model Job {
  id               String         @id @default(uuid()) @db.Uuid
  companyId        String         @map("company_id") @db.Uuid
  recruiterId      String         @map("recruiter_id") @db.Uuid
  title            String         @db.VarChar(200)
  description      String         @db.Text
  requirements     String?        @db.Text
  benefits         String?        @db.Text
  location         String         @db.VarChar(160)
  employmentType   EmploymentType @map("employment_type")
  workMode         WorkMode       @default(ONSITE) @map("work_mode")
  category         String?        @db.VarChar(80)
  level            String?        @db.VarChar(80)
  headcount        Int            @default(1)
  skills           Json?
  experienceMin    Int?           @map("experience_min")
  experienceMax    Int?           @map("experience_max")
  fastResponse     Boolean        @default(false) @map("fast_response")
  salaryMin        Decimal?       @map("salary_min") @db.Decimal(12, 2)
  salaryMax        Decimal?       @map("salary_max") @db.Decimal(12, 2)
  salaryNegotiable Boolean        @default(false) @map("salary_negotiable")
  currency         String         @default("VND") @db.VarChar(3)
  status           JobStatus      @default(PENDING)
  rejectionNote    String?        @map("rejection_note") @db.Text
  publishedAt      DateTime?      @map("published_at") @db.Timestamptz(6)
  expiresAt        DateTime?      @map("expires_at") @db.Timestamptz(6)
  createdAt        DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)

  company     Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  recruiter   User          @relation("JobRecruiter", fields: [recruiterId], references: [id], onDelete: Restrict)
  applications Application[]

  @@index([status, createdAt])
  @@index([companyId])
  @@index([recruiterId, status])
  @@index([category, status])
  @@map("jobs")
}

model Application {
  id                   String            @id @default(uuid()) @db.Uuid
  jobId                String            @map("job_id") @db.Uuid
  candidateId          String            @map("candidate_id") @db.Uuid
  cvUrl                String            @map("cv_url") @db.VarChar(2048)
  coverLetter          String?           @map("cover_letter") @db.Text
  status               ApplicationStatus @default(APPLIED)
  interviewScheduledAt DateTime?         @map("interview_scheduled_at") @db.Timestamptz(6)
  interviewDetails     String?           @map("interview_details") @db.VarChar(500)
  createdAt            DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt            DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)

  job       Job  @relation(fields: [jobId], references: [id], onDelete: Restrict)
  candidate User @relation("CandidateApplications", fields: [candidateId], references: [id], onDelete: Restrict)

  @@unique([jobId, candidateId])
  @@index([candidateId, createdAt])
  @@index([jobId, status])
  @@map("applications")
}

model Notification {
  id        String   @id @default(uuid()) @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  type      String   @db.VarChar(80)
  title     String   @db.VarChar(200)
  body      String   @db.Text
  payload   Json?
  readAt    DateTime? @map("read_at") @db.Timestamptz(6)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, readAt, createdAt])
  @@map("notifications")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id") @db.Uuid
  targetId   String?  @map("target_id") @db.Uuid
  action     String   @db.VarChar(100)
  entityType String   @map("entity_type") @db.VarChar(80)
  entityId   String   @map("entity_id") @db.VarChar(100)
  details    Json?
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  actor  User  @relation("AuditActor", fields: [actorId], references: [id], onDelete: Restrict)
  target User? @relation("AuditTarget", fields: [targetId], references: [id], onDelete: SetNull)

  @@index([entityType, entityId, createdAt])
  @@index([actorId, createdAt])
  @@map("audit_logs")
}


model RefreshToken {
  id          String    @id @default(uuid()) @db.Uuid
  userId      String    @map("user_id") @db.Uuid
  tokenHash   String    @unique @map("token_hash") @db.Char(64)
  expiresAt   DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt   DateTime? @map("revoked_at") @db.Timestamptz(6)
  userAgent   String?   @map("user_agent") @db.VarChar(500)
  ipAddress   String?   @map("ip_address") @db.VarChar(64)
  deviceLabel String?   @map("device_label") @db.VarChar(160)
  createdAt   DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("refresh_tokens")
}
