{
  "name": "@recruitment/backend",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n gateway,auth,jobs,applications,notifications \"npm:dev:gateway\" \"npm:dev:auth\" \"npm:dev:jobs\" \"npm:dev:applications\" \"npm:dev:notifications\"",
    "dev:gateway": "nest start --watch --entryFile main",
    "dev:auth": "nest start --watch --entryFile services/main-auth",
    "dev:jobs": "nest start --watch --entryFile services/main-jobs",
    "dev:applications": "nest start --watch --entryFile services/main-applications",
    "dev:notifications": "nest start --watch --entryFile services/main-notifications",
    "build": "prisma generate && nest build",
    "start:gateway": "node dist/main.js",
    "start:auth": "node dist/services/main-auth.js",
    "start:jobs": "node dist/services/main-jobs.js",
    "start:applications": "node dist/services/main-applications.js",
    "start:notifications": "node dist/services/main-notifications.js",
    "db:generate": "prisma generate",
    "db:migrate": "dotenv -e ../../.env -- prisma migrate dev --name init",
    "db:deploy": "dotenv -e ../../.env -- prisma migrate deploy",
    "db:seed-admin": "node prisma/seed-admin.cjs"
  },
  "dependencies": {
    "@nestjs/common": "^11.1.6",
    "@nestjs/core": "^11.1.6",
    "@nestjs/jwt": "^11.0.1",
    "@nestjs/microservices": "^11.1.6",
    "@nestjs/platform-express": "^11.1.6",
    "@prisma/client": "6.19.3",
    "bcryptjs": "^3.0.2",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.2",
    "cookie-parser": "^1.4.7",
    "dotenv": "^16.6.1",
    "express": "^5.1.0",
    "kafkajs": "^2.2.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.10",
    "@types/cookie-parser": "^1.4.9",
    "@types/express": "^5.0.3",
    "@types/node": "^22.18.6",
    "concurrently": "^9.2.1",
    "dotenv-cli": "^10.0.0",
    "prisma": "6.19.3",
    "typescript": "^5.9.2"
  }
}
