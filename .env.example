# Copy this file to .env and replace every placeholder locally.
# Keep real credentials out of Git, chat, logs, and shared screenshots.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Local npm: localhost:9092 | docker compose overrides to kafka:9092
KAFKA_BROKERS=localhost:9092
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=4001
JOBS_SERVICE_HOST=127.0.0.1
JOBS_SERVICE_PORT=4002
APPLICATIONS_SERVICE_HOST=127.0.0.1
APPLICATIONS_SERVICE_PORT=4003
NOTIFICATIONS_SERVICE_HOST=127.0.0.1
NOTIFICATIONS_SERVICE_PORT=4004

# Optional: set these only when creating the first admin account.
ADMIN_EMAIL=
ADMIN_FULL_NAME=
ADMIN_PASSWORD=
