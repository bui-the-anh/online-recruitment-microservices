# Copy to .env and fill placeholders locally. Never commit .env.
# Percent-encode special characters in the password, such as @ as %40.
DATABASE_URL="postgresql://postgres.<project-ref>:<password>@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres?schema=public"
JWT_SECRET="replace-with-a-long-random-secret"
ADMIN_EMAIL=""
ADMIN_FULL_NAME=""
ADMIN_PASSWORD=""
API_PORT=3001
WEB_ORIGIN=http://localhost:3000
KAFKA_BROKERS=localhost:19092
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=4001
JOBS_SERVICE_HOST=127.0.0.1
JOBS_SERVICE_PORT=4002
APPLICATIONS_SERVICE_HOST=127.0.0.1
APPLICATIONS_SERVICE_PORT=4003
NOTIFICATIONS_SERVICE_HOST=127.0.0.1
