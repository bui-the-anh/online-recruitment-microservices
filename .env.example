# App runtime: transaction pooler (tránh EMAXCONNSESSION khi nhiều microservice)
DATABASE_URL="postgresql://postgres.<project-ref>:<password-percent-encoded>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1&schema=public"
# Migrations / prisma migrate: session/direct
DIRECT_URL="postgresql://postgres.<project-ref>:<password-percent-encoded>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public"
JWT_SECRET="replace-with-a-random-secret-at-least-32-characters-long"

API_PORT=3001
WEB_ORIGIN=http://localhost:3000
# Local npm: 127.0.0.1:9092 | Docker Compose override sang kafka:9092
KAFKA_BROKERS=127.0.0.1:9092
AUTH_SERVICE_HOST=127.0.0.1
AUTH_SERVICE_PORT=4001
JOBS_SERVICE_HOST=127.0.0.1
JOBS_SERVICE_PORT=4002
APPLICATIONS_SERVICE_HOST=127.0.0.1
APPLICATIONS_SERVICE_PORT=4003
NOTIFICATIONS_SERVICE_HOST=127.0.0.1
NOTIFICATIONS_SERVICE_PORT=4004

ADMIN_EMAIL=admin@careerlink.local
ADMIN_FULL_NAME=System Admin
ADMIN_PASSWORD=AdminPass123!

# Supabase Storage (CV uploads)
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-supabase-service-role-key
SUPABASE_STORAGE_BUCKET=online-recruitment-microservices
